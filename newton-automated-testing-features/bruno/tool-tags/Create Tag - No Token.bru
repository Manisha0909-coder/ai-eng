meta {
  name: Create Tag - No Token
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/mid/tool-tags/
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Tag - No Token] Running negative test: missing auth cookie");
}

body:json {
  {
    "name": "Should Not Be Created",
    "tool_names": ["addition_tool"],
    "description": null
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [401];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Tag - No Token] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Tag - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
