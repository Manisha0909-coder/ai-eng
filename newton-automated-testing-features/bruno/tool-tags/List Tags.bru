meta {
  name: List Tags
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/mid/tool-tags/list
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "limit": 50,
    "offset": 0,
    "search": null
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response data contains tags array", function() {
    const data = res.getBody().data;
    const tags = data?.tags ?? data?.items ?? data?.results;
    expect(tags).to.be.an("array");
  });
}
