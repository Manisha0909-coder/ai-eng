meta {
  name: Get File - Invalid Name
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/mid/files/00000000-0000-0000-0000-000000000000.jpg
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Get File - Invalid Name] Running negative test: non-existent file name");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 403, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Get File - Invalid Name] Expected ${expected.join("/")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Get File - Invalid Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400, 403, or 404", function() {
    expect([400, 403, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
