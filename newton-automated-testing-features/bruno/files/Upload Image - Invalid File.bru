meta {
  name: Upload Image - Invalid File
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/mid/files/images/upload
  body: multipartForm
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:multipart-form {
  file: @file(../test-data/test_data.csv)
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Upload Image - Invalid File] Running negative test: non-image file (CSV)");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Upload Image - Invalid File] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Upload Image - Invalid File] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });

  test("Response message mentions image format", function() {
    expect(res.getBody().message).to.match(/image|format|supported/i);
  });
}
