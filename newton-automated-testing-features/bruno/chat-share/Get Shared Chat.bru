meta {
  name: Get Shared Chat
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/mid/chat_share/{{chat_id}}
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

vars:pre-request {
  chat_id:
}

script:pre-request {
  const cid = bru.getVar("chat_id");
  if (!cid || cid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains shared chat data", function() {
    const body = res.getBody();
    const hasData = body.data && (body.data.id || body.data.session_id || body.data.shareable_url);
    expect(hasData).to.be.ok;
  });
}
