meta {
  name: Create Shared Chat - Missing Session ID
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/mid/chat_share/create
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "is_public": true
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Shared Chat - Missing Session ID] Running negative test: no session_id field");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Shared Chat - Missing Session ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Shared Chat - Missing Session ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
