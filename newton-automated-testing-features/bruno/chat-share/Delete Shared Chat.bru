meta {
  name: Delete Shared Chat
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/api/mid/chat_share/{{chat_id}}
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

vars:pre-request {
  chat_id:
}

script:pre-request {
  const cid = bru.getVar("chat_id");
  if (!cid || cid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
