meta {
  name: Create Shared Chat
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/mid/chat_share/create
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "session_id": "{{session_id}}",
    "is_public": true
  }
}

vars:pre-request {
  session_id:
}

script:pre-request {
  const sid = bru.getVar("session_id");
  if (!sid || sid.trim() === "") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.id) {
    bru.setVar("chat_id", body.data.id);
    console.log("chat_id captured:", body.data.id);
  } else {
    console.log("WARNING: chat_id not found in response");
  }
}

tests {
  test("Status is 200 or 201", function() {
    expect([200, 201]).to.include(res.getStatus());
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains shared chat id", function() {
    expect(res.getBody().data.id).to.be.a('string');
  });
}
