meta {
  name: Get Public Shared Chat
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/mid/chat_share/{{chat_id}}/public
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

vars:pre-request {
  chat_id:
}

script:pre-request {
  const cid = bru.getVar("chat_id");
  if (!cid || cid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains public chat data", function() {
    const body = res.getBody();
    expect(body.data).to.be.an('object');
  });
}
