meta {
  name: Update Tool Server - Invalid Name
  type: http
  seq: 18
}

post {
  url: {{base_url}}/api/mid/tool-servers/update
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Update Tool Server - Invalid Name] Running negative test: nonexistent current_name");
}

body:json {
  {
    "current_name": "nonexistent-tool-server-99999",
    "new_name": null,
    "url": null,
    "envs": null,
    "type": null
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Update Tool Server - Invalid Name] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Update Tool Server - Invalid Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
