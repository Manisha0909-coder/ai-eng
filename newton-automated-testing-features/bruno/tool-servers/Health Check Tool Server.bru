meta {
  name: Health Check Tool Server
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/mid/tool-servers/health
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  const serverName = bru.getEnvVar("ts_server_name") || "TEST_SERVER";
  req.setBody({ server_name: serverName });
}

body:json {
  {
    "server_name": "TEST_SERVER"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
