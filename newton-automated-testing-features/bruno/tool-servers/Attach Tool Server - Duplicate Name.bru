meta {
  name: Attach Tool Server - Duplicate Name
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/mid/tool-servers/attach
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Attach Tool Server - Duplicate Name] Running negative test: attaching already-attached server");

  const token = bru.getEnvVar("access_token");
  const baseUrl = bru.getEnvVar("base_url");

  // Attach TEST_SERVER so we can test the duplicate-attach case
  await bru.sendRequest({
    url: `${baseUrl}/api/mid/tool-servers/attach`,
    method: "POST",
    headers: {
      "Cookie": `access_token=${token}`,
      "Content-Type": "application/json"
    },
    data: {
      name: "TEST_SERVER",
      url: "http://localhost:9005",
      type: "custom",
      envs: { "TEST_TOOL_SERVER_BASE_URL": "http://localhost:9005" }
    }
  });

  // Now send the duplicate attach as the actual request
  req.setBody({
    name: "TEST_SERVER",
    url: "http://localhost:9005",
    type: "custom",
    envs: { "TEST_TOOL_SERVER_BASE_URL": "http://localhost:9005" }
  });
}

body:json {
  {
    "name": "TEST_SERVER",
    "url": "http://localhost:9005",
    "type": "custom",
    "envs": { "TEST_TOOL_SERVER_BASE_URL": "http://localhost:9005" }
  }
}

script:post-response {
  const token = bru.getEnvVar("access_token");
  const baseUrl = bru.getEnvVar("base_url");

  // Clean up — detach TEST_SERVER after the test
  try {
    await bru.sendRequest({
      url: `${baseUrl}/api/mid/tool-servers/detach`,
      method: "POST",
      headers: {
        "Cookie": `access_token=${token}`,
        "Content-Type": "application/json"
      },
      data: { name: "TEST_SERVER" }
    });
    console.log("✅ [Attach Tool Server - Duplicate Name] Cleaned up TEST_SERVER after test");
  } catch (e) {
    console.warn("⚠️  [Attach Tool Server - Duplicate Name] Cleanup detach failed:", e.message);
  }
}

tests {
  test("Status is 400 or 409", function() {
    expect([400, 409]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
