meta {
  name: Update Tool Server - No Token
  type: http
  seq: 17
}

post {
  url: {{base_url}}/api/mid/tool-servers/update
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Update Tool Server - No Token] Running negative test: missing auth cookie");
}

body:json {
  {
    "current_name": "TEST_SERVER",
    "new_name": null,
    "url": null,
    "envs": null,
    "type": null
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [401];
  if (!expected.includes(status)) {
    console.error(`❌ [Update Tool Server - No Token] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Update Tool Server - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
