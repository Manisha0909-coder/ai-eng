meta {
  name: Attach Tool Server - Missing URL
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/mid/tool-servers/attach
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Attach Tool Server - Missing URL] Running negative test: body missing url field");
}

body:json {
  {
    "name": "TEST_SERVER",
    "type": "custom",
    "envs": null
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Attach Tool Server - Missing URL] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Attach Tool Server - Missing URL] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
