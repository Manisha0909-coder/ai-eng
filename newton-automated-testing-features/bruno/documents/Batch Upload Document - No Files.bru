meta {
  name: Batch Upload Document - No Files
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/core/documents/batch-upload
  body: multipartForm
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:multipart-form {
  description: No files test
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Batch Upload Documents - No Files] Running negative test: no files in request");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Batch Upload Documents - No Files] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Batch Upload Documents - No Files] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
