meta {
  name: List Documents
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/core/documents
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains documents array", function() {
    expect(res.getBody().data.documents).to.be.an('array');
  });
}
