meta {
  name: Upload Document - No Token
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/core/documents/upload
  body: multipartForm
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

body:multipart-form {
  file: @file(../test-data/test.pdf)
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Upload Document - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Upload Document - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Upload Document - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
