meta {
  name: Search Documents
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/core/search
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "query": "test",
    "session_id": "{{session_id}}",
    "limit": 10
  }
}

script:pre-request {
  let sid = bru.getVar("session_id");
  if (!sid || sid.trim() === "") {
    const axios = require("axios");
    const baseUrl = bru.getEnvVar("base_url");
    const token = bru.getEnvVar("access_token");
    const personaId = bru.getEnvVar("persona_id");

    try {
      const chatRes = await axios.post(
        `${baseUrl}/api/mid/chat/create`,
        { timezone: "Asia/Kolkata", session_id: null, query: "hi", persona_id: Number(personaId), language: "EN" },
        { headers: { Cookie: `access_token=${token}`, "x-title": "Newton Chat" }, responseType: "text" }
      );

      const lines = chatRes.data.split("\n");
      for (let i = 0; i < lines.length; i++) {
        if (lines[i].trim() === "event: message") {
          const dataLine = lines[i + 1] || "";
          if (dataLine.startsWith("data: ")) {
            try {
              const data = JSON.parse(dataLine.slice(6));
              if (data.session_id) {
                bru.setVar("session_id", data.session_id);
                console.log("session_id fetched from Create Chat:", data.session_id);
                break;
              }
            } catch (e) {}
          }
        }
      }
    } catch (e) {
      console.log("Failed to fetch session_id from Create Chat:", e.message);
    }

    sid = bru.getVar("session_id");
    if (!sid || sid.trim() === "") {
      bru.runner.skipRequest();
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains results", function() {
    expect(res.getBody().data).to.not.equal(null);
  });
}
