meta {
  name: Create Feedback
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/mid/feedback/
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "message_id": "{{message_id}}",
    "feedback_type": "thumbs_up",
    "reason": ""
  }
}

vars:pre-request {
  message_id:
}

script:pre-request {
  const mid = bru.getVar("message_id");
  if (!mid || mid.trim() === "") {
    bru.runner.skipRequest();
  }
}

script:post-response {
  const body = res.getBody();
  console.log("Create Feedback response:", JSON.stringify(body));
  if (body && body.data && body.data.feedback_id) {
    bru.setVar("feedback_id", String(body.data.feedback_id));
    console.log("feedback_id captured:", body.data.feedback_id);
  } else {
    console.log("WARNING: feedback_id not found in response");
  }
}

tests {
  test("Status is 200 or 201", function() {
    expect([200, 201]).to.include(res.getStatus());
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains feedback id", function() {
    expect(res.getBody().data.feedback_id).to.be.a('number');
  });
}
