meta {
  name: Create Feedback - Invalid Type
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/mid/feedback/
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "message_id": "00000000-0000-0000-0000-000000000000",
    "feedback_type": "invalid_type",
    "reason": ""
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Feedback - Invalid Type] Running negative test: invalid feedback_type value");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Feedback - Invalid Type] Expected ${expected.join("/")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Feedback - Invalid Type] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400, 404, or 422", function() {
    expect([400, 404, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
