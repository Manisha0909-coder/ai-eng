meta {
  name: Resolve Feedback
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/mid/feedback/{{feedback_id}}/resolve
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "resolution_comment": "Resolved via Bruno test."
  }
}

vars:pre-request {
  feedback_id:
}

script:pre-request {
  const fid = bru.getVar("feedback_id");
  if (!fid || fid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
