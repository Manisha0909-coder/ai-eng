meta {
  name: Resolve Feedback - Invalid ID
  type: http
  seq: 17
}

patch {
  url: {{base_url}}/api/mid/feedback/999999999/resolve
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "resolution_comment": "Should not resolve."
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Resolve Feedback - Invalid ID] Running negative test: non-existent feedback id");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 403, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Resolve Feedback - Invalid ID] Expected ${expected.join("/")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Resolve Feedback - Invalid ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400, 403, or 404", function() {
    expect([400, 403, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
