meta {
  name: Bulk Delete Feedback - No Token
  type: http
  seq: 21
}

delete {
  url: {{base_url}}/api/mid/feedback/bulk/delete
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

body:json {
  {
    "feedback_ids": ["999999999"]
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Bulk Delete Feedback - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Bulk Delete Feedback - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Bulk Delete Feedback - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
