meta {
  name: Bulk Delete Feedback
  type: http
  seq: 9
}

delete {
  url: {{base_url}}/api/mid/feedback/bulk/delete
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "feedback_ids": ["{{bulk_feedback_id}}"]
  }
}

vars:pre-request {
  bulk_feedback_id:
}

script:pre-request {
  const fid = bru.getVar("bulk_feedback_id");
  if (!fid || fid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
