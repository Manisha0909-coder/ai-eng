meta {
  name: Bulk Resolve Feedback - No Token
  type: http
  seq: 20
}

patch {
  url: {{base_url}}/api/mid/feedback/bulk/resolve
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

body:json {
  {
    "feedbacks": [
      {
        "feedback_id": "999999999",
        "resolution_comment": "Should not resolve."
      }
    ]
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Bulk Resolve Feedback - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Bulk Resolve Feedback - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Bulk Resolve Feedback - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
