meta {
  name: Query Service Logs - Missing Service Name
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/mid/observability/logs
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "limit": 10,
    "sort_order": "desc"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Query Service Logs - Missing Service Name] Running negative test: no service_name field");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Query Service Logs - Missing Service Name] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Query Service Logs - Missing Service Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
