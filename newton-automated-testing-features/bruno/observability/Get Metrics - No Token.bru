meta {
  name: Get Metrics - No Token
  type: http
  seq: 9
}

get {
  url: {{base_url}}/api/mid/observability/metrics
  body: none
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

params:query {
  query: up
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Get Metrics - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Get Metrics - No Token] Expected 401 — got ${status}`);
  } else {
    console.log(`✅ [Get Metrics - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
