meta {
  name: Get Metrics
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/mid/observability/metrics
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

params:query {
  query: up
  ~start:
  ~end:
  ~step:
}

script:pre-request {
  // 400 is valid when Prometheus is not configured — suppress collection-level error guard
  bru.setVar("negative_test", true);
}

tests {
  test("Status is 200 or 400", function() {
    expect([200, 400]).to.include(res.getStatus());
  });
}
