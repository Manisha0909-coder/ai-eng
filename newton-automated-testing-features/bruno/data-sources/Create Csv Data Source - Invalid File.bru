meta {
  name: Create Csv Data Source - Invalid File
  type: http
  seq: 30
}

post {
  url: {{base_url}}/api/core/api/data-sources/csv
  body: multipartForm
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:multipart-form {
  datasource_name: Bruno Test Invalid CSV
  file: @file(../test-data/invalid_data.csv)
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Csv Data Source - Invalid File] Running negative test: malformed CSV content");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Csv Data Source - Invalid File] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Csv Data Source - Invalid File] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
