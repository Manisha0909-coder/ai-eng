meta {
  name: Get Global Data Sources
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/core/api/data-sources/global
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains data", function() {
    expect(res.getBody().data).to.not.equal(null);
  });
}
