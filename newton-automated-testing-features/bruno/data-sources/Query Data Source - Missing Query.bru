meta {
  name: Query Data Source - Empty Query
  type: http
  seq: 25
}

post {
  url: {{base_url}}/api/core/api/data-sources/{{source_id}}/query
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "query": ""
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  // Always fetch a live source — source_id at this seq may point to a deleted source
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("base_url");
  const token = bru.getEnvVar("access_token");
  let sid = "";
  try {
    const res = await axios.get(`${baseUrl}/api/core/api/data-sources/global`, {
      headers: { Cookie: `access_token=${token}` }
    });
    const sources = res.data.data && res.data.data.sources;
    if (Array.isArray(sources) && sources.length > 0) {
      const src = sources.find(s => s.kind === "postgresql") || sources[0];
      sid = src.id;
      bru.setVar("source_id", sid);
      console.log("source_id fetched for negative test:", sid, "(kind:", src.kind + ")");
    }
  } catch (e) {
    console.log("Failed to fetch source_id:", e.message);
  }
  if (!sid || sid.trim() === "") {
    bru.runner.skipRequest();
  }
  console.log("[Query Data Source - Empty Query] Running negative test: empty query string");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 400) {
    console.error(`❌ [Query Data Source - Empty Query] Expected 400 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Query Data Source - Empty Query] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });

  test("Response message indicates empty query", function() {
    expect(res.getBody().message).to.include("empty");
  });
}
