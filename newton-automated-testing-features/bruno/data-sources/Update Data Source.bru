meta {
  name: Update Data Source
  type: http
  seq: 10
}

put {
  url: {{base_url}}/api/core/api/data-sources/{{update_source_id}}
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "datasource_name": "Bruno Test DS (Updated) {{$timestamp}}"
  }
}

script:pre-request {
  // e4a20e27 is a persistent PG source that reliably accepts updates.
  // Newly created PG sources and some others return 500 intermittently (backend bug).
  const RELIABLE_ID = "e4a20e27-db25-4197-ac8f-18cdf79c6815";
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("base_url");
  const token = bru.getEnvVar("access_token");
  const newId = bru.getVar("pg_source_id");
  try {
    const res = await axios.get(`${baseUrl}/api/core/api/data-sources/global`, {
      headers: { Cookie: `access_token=${token}` }
    });
    const sources = res.data.data && res.data.data.sources;
    if (Array.isArray(sources) && sources.length > 0) {
      const preferred = sources.find(s => s.id === RELIABLE_ID);
      const fallback = sources.find(s => s.kind === "postgresql" && s.id !== newId);
      const src = preferred || fallback || sources.find(s => s.kind === "postgresql") || sources[0];
      bru.setVar("update_source_id", src.id);
      console.log("update_source_id:", src.id, "(kind:", src.kind + ")");
    }
  } catch (e) {
    console.log("Failed to fetch sources:", e.message);
  }
  if (!bru.getVar("update_source_id")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
