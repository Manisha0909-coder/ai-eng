meta {
  name: Create Persona - No Token
  type: http
  seq: 19
}

post {
  url: {{base_url}}/api/mid/personas/
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Persona - No Token] Running negative test: missing auth");
}

body:json {
  {
    "persona_name": "Should Not Be Created",
    "persona": "You are a test assistant.",
    "model_id": null,
    "type": "chat",
    "temperature": 0.7,
    "context_window_limit": 4096
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Create Persona - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Persona - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
