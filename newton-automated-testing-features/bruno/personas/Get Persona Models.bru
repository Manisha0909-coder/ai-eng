meta {
  name: Get Persona Models
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/mid/personas/models
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response data contains models array", function() {
    expect(res.getBody().data.models).to.be.an('array');
  });
}
