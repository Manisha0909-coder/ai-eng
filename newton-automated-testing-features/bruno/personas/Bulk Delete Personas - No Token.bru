meta {
  name: Bulk Delete Personas - No Token
  type: http
  seq: 31
}

post {
  url: {{base_url}}/api/mid/personas/bulk_delete
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Bulk Delete Personas - No Token] Running negative test: missing auth");
}

body:json {
  {
    "persona_ids": []
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Bulk Delete Personas - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Bulk Delete Personas - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
