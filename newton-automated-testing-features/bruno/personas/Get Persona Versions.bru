meta {
  name: Get Persona Versions
  type: http
  seq: 11
}

get {
  url: {{base_url}}/api/mid/personas/{{persona_id}}/versions
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response data contains versions array", function() {
    expect(res.getBody().data.versions).to.be.an('array');
  });
}
