meta {
  name: Create Persona - Missing Name
  type: http
  seq: 46
}

post {
  url: {{base_url}}/api/mid/personas/
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Persona - Missing Name] Running negative test: body has no persona_name field");
}

body:json {
  {
    "persona": "You are a test assistant.",
    "model_id": null,
    "type": "chat",
    "temperature": 0.7,
    "context_window_limit": 4096
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Persona - Missing Name] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Persona - Missing Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
