meta {
  name: Create Persona Version - Invalid Persona ID
  type: http
  seq: 38
}

post {
  url: {{base_url}}/api/mid/personas/999999999/versions
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Persona Version - Invalid Persona ID] Running negative test: nonexistent persona_id 999999999");
}

body:json {
  {
    "set_as_current": true
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Persona Version - Invalid Persona ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Persona Version - Invalid Persona ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
