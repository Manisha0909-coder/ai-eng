meta {
  name: Bulk Attach Roles
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/mid/personas/{{persona_id}}/bulk_attach_roles
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  const token = bru.getEnvVar("access_token");
  const baseUrl = bru.getEnvVar("base_url");

  const res = await bru.sendRequest({
    url: `${baseUrl}/api/mid/roles/list`,
    method: "POST",
    headers: {
      "Cookie": `access_token=${token}`,
      "Content-Type": "application/json"
    },
    data: { limit: 1, offset: 0, search: null }
  });

  const roles = res.data?.data?.roles ?? res.data?.data?.items ?? [];
  const roleId = roles.length > 0 ? roles[0].id : null;
  console.log(`[Bulk Attach Roles] Using role_id: ${roleId}`);
  req.setBody({ role_ids: roleId ? [roleId] : [] });
}

body:json {
  {
    "role_ids": []
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });
}
