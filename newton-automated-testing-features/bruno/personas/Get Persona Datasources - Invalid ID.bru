meta {
  name: Get Persona Datasources - Invalid ID
  type: http
  seq: 37
}

get {
  url: {{base_url}}/api/mid/personas/999999999/datasources
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  console.log("[Get Persona Datasources - Invalid ID] Running negative test: nonexistent persona_id 999999999");
  bru.setVar("negative_test", true);
}

script:post-response {
  const status = res.getStatus();
  const body = res.getBody();
  if (status === 404) {
    console.log(`✅ [Get Persona Datasources - Invalid ID] Correctly rejected with 404`);
  } else {
    console.error(`❌ [Get Persona Datasources - Invalid ID] Expected 404 — got ${status}`);
    console.error(`Response: ${JSON.stringify(body)}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
