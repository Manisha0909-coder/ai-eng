meta {
  name: Get Persona
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/mid/personas/{{persona_id}}
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains persona id", function() {
    expect(res.getBody().data.persona.id).to.be.a('number');
  });
}
