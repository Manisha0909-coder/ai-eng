meta {
  name: Push Card - No Token
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/mid/queue/push_card
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key: {{api_key}}
  Content-Type: application/json
}

body:json {
  {
    "session_id": "test-session"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Push Card - No Token] Running negative test: missing auth token");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Push Card - No Token] Expected 401 — got ${status}`);
  } else {
    console.log(`✅ [Push Card - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
