meta {
  name: Delete User - Invalid ID
  type: http
  seq: 34
}

delete {
  url: {{base_url}}/api/mid/users/nonexistent_user@invalid.xyz
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Delete User - Invalid ID] Running negative test: nonexistent user ID");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Delete User - Invalid ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Delete User - Invalid ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });
}
