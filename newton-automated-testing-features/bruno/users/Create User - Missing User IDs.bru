meta {
  name: Create User - Missing User IDs
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/mid/users/
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create User - Missing User IDs] Running negative test: body has no user_ids field");
}

body:json {
  {
    "roles": []
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create User - Missing User IDs] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create User - Missing User IDs] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
