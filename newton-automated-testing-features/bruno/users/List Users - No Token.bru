meta {
  name: List Users - No Token
  type: http
  seq: 16
}

post {
  url: {{base_url}}/api/mid/users/list
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[List Users - No Token] Running negative test: missing auth cookie");
}

body:json {
  {
    "limit": 50,
    "offset": 0,
    "search": null,
    "include_admins": true
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [401];
  if (!expected.includes(status)) {
    console.error(`❌ [List Users - No Token] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [List Users - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
