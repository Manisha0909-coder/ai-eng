meta {
  name: Export Users CSV - No Token
  type: http
  seq: 36
}

get {
  url: {{base_url}}/api/mid/users/export
  body: none
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Export Users CSV - No Token] Running negative test: missing auth cookie");
}

script:post-response {
  const status = res.getStatus();
  const expected = [401];
  if (!expected.includes(status)) {
    console.error(`❌ [Export Users CSV - No Token] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Export Users CSV - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
