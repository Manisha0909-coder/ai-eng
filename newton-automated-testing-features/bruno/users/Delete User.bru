meta {
  name: Delete User
  type: http
  seq: 8
}

delete {
  url: {{base_url}}/api/mid/users/{{user_id}}
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

vars:pre-request {
  user_id: {{test_email}}
}

tests {
  test("Status is 200 or 204", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}
