meta {
  name: Get User Details by Session - No Token
  type: http
  seq: 24
}

post {
  url: {{base_url}}/api/mid/users/user_details
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Get User Details by Session - No Token] Running negative test: missing auth cookie");
}

body:json {
  {
    "session_id": "some-session-id",
    "agent_id": null,
    "connection": null
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [401];
  if (!expected.includes(status)) {
    console.error(`❌ [Get User Details by Session - No Token] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Get User Details by Session - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
