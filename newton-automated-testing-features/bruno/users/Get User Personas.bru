meta {
  name: Get User Personas
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/mid/users/personas
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response data contains personas array", function() {
    expect(res.getBody().data.personas).to.be.an('array');
  });
}
