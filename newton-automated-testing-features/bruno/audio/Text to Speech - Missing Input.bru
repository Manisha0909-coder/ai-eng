meta {
  name: Text to Speech - Missing Input
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/mid/audio/text-to-speech
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Text to Speech - Missing Input] Running negative test: body missing required input field");
}

body:json {
  {
    "model": "tts-1",
    "voice": "onyx"
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Text to Speech - Missing Input] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Text to Speech - Missing Input] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
