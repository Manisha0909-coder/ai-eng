meta {
  name: Create Chat - Empty Query
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/mid/chat/create
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
  x-title: Newton Chat
}

body:json {
  {
    "timezone": "Asia/Kolkata",
    "session_id": null,
    "query": "",
    "persona_id": {{persona_id}},
    "language": "EN"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Chat - Empty Query] Running negative test: empty query field");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Chat - Empty Query] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Chat - Empty Query] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
