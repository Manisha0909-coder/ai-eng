meta {
  name: Cancel Chat - No Token
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/mid/chat/cancel
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

body:json {
  {
    "session_id": "00000000-0000-0000-0000-000000000000"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Cancel Chat - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Cancel Chat - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Cancel Chat - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
