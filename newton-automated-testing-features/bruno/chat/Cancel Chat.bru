meta {
  name: Cancel Chat
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/mid/chat/cancel
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "session_id": "{{session_id}}"
  }
}

vars:pre-request {
  session_id:
}

script:pre-request {
  const sid = bru.getVar("session_id");
  if (!sid || sid.trim() === "") {
    bru.runner.skipRequest();
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}