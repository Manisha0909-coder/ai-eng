meta {
  name: Cancel Chat - Invalid Session ID
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/mid/chat/cancel
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "session_id": "00000000-0000-0000-0000-000000000000"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Cancel Chat - Invalid Session ID] Running negative test: nonexistent session_id");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Cancel Chat - Invalid Session ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Cancel Chat - Invalid Session ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
