meta {
  name: Update Tool - Invalid Name
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/mid/tool_names/nonexistent_tool_99999
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "display_name": "Invalid Name Update"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Update Tool - Invalid Name] Running negative test: nonexistent tool name");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Update Tool - Invalid Name] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Update Tool - Invalid Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
