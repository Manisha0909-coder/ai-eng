meta {
  name: Update Tool - No Token
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/mid/tool_names/echo_message
  body: json
  auth: none
}

headers {
  Cookie:
  X-API-Key:
}

body:json {
  {
    "display_name": "No Token Update"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Update Tool - No Token] Running negative test: missing auth");
}

script:post-response {
  const status = res.getStatus();
  if (status !== 401) {
    console.error(`❌ [Update Tool - No Token] Expected 401 — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Update Tool - No Token] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
