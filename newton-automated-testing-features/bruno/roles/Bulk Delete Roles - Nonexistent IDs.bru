meta {
  name: Bulk Delete Roles - Nonexistent IDs
  type: http
  seq: 20
}

post {
  url: {{base_url}}/api/mid/roles/bulk_delete
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  console.log("[Bulk Delete Roles - Nonexistent IDs] Running negative test: role IDs that do not exist");
}

body:json {
  {
    "role_ids": [999999999]
  }
}

script:post-response {
  const body = res.getBody();
  const totalDeleted = body?.data?.total_deleted;
  const totalFailed = body?.data?.total_failed;
  if (totalDeleted !== 0 || totalFailed === 0) {
    console.error(`❌ [Bulk Delete Roles - Nonexistent IDs] Expected 0 deleted / ≥1 failed — got deleted=${totalDeleted} failed=${totalFailed}`);
    console.error(`Response: ${JSON.stringify(body)}`);
  } else {
    console.log(`✅ [Bulk Delete Roles - Nonexistent IDs] Correctly reported 0 deleted, ${totalFailed} failed`);
  }
}

tests {
  test("Status is 200 (bulk op always returns 200)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("No roles were deleted", function() {
    expect(res.getBody().data.total_deleted).to.equal(0);
  });

  test("All submitted IDs reported as failed", function() {
    expect(res.getBody().data.total_failed).to.be.above(0);
  });

  test("Per-item result shows role not found", function() {
    const result = res.getBody().data.results[0];
    expect(result.success).to.equal(false);
    expect(result.role_id).to.equal(999999999);
  });
}
