meta {
  name: Bulk Attach Users - Invalid Role ID
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/mid/roles/999999999/bulk_attach_users
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "user_ids": []
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Bulk Attach Users - Invalid Role ID] Running negative test: nonexistent role_id 999999999");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Bulk Attach Users - Invalid Role ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Bulk Attach Users - Invalid Role ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response success is not true", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
