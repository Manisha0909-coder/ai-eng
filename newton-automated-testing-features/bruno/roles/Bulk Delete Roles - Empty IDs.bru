meta {
  name: Bulk Delete Roles - Empty IDs
  type: http
  seq: 19
}

post {
  url: {{base_url}}/api/mid/roles/bulk_delete
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Bulk Delete Roles - Empty IDs] Running negative test: role_ids is empty array");
}

body:json {
  {
    "role_ids": []
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Bulk Delete Roles - Empty IDs] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Bulk Delete Roles - Empty IDs] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
