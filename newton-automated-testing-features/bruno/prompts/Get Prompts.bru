meta {
  name: Get Prompts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/mid/prompts/
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response success is true", function() {
    expect(res.getBody().success).to.equal(true);
  });

  test("Response contains system_prompt", function() {
    expect(res.getBody().data.system_prompt).to.be.a('string');
    expect(res.getBody().data.system_prompt.length).to.be.greaterThan(0);
  });

  test("Response contains dashboard_system_prompt", function() {
    expect(res.getBody().data.dashboard_system_prompt).to.be.a('string');
    expect(res.getBody().data.dashboard_system_prompt.length).to.be.greaterThan(0);
  });
}
