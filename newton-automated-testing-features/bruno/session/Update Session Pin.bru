meta {
  name: Update Session Pin
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/mid/session/update_chat_session_pin
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "session_id": "{{session_id}}",
    "is_pin": true
  }
}

script:pre-request {
  const sid = bru.getEnvVar("session_id");
  if (!sid || sid.trim() === "") {
    bru.runner.skipRequest();
    return;
  }
  req.setBody({ session_id: sid, is_pin: true });
}