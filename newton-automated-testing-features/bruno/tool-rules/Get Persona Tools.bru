meta {
  name: Get Persona Tools
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/mid/tool-rules/personas/{{persona_id}}/tools
  body: none
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has tools array", function() {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data).to.have.property("tools");
    expect(body.data.tools).to.be.an("array");
  });
}
