meta {
  name: Update Persona Tool Rules - Invalid ID
  type: http
  seq: 10
}

put {
  url: {{base_url}}/api/mid/tool-rules/personas/999999999
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Update Persona Tool Rules - Invalid ID] Running negative test: nonexistent persona_id 999999999");
}

body:json {
  {
    "tool_rules": []
  }
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 404];
  if (!expected.includes(status)) {
    console.error(`❌ [Update Persona Tool Rules - Invalid ID] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Update Persona Tool Rules - Invalid ID] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 404", function() {
    expect([400, 404]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
