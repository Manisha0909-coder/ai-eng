meta {
  name: Create Personal Doc Tag - Missing Name
  type: http
  seq: 14
}

post {
  url: {{base_url}}/api/mid/personal-doc-tag/
  body: json
  auth: none
}

headers {
  Cookie: access_token={{access_token}}
}

body:json {
  {
    "description": "Tag with no name"
  }
}

script:pre-request {
  bru.setVar("negative_test", true);
  console.log("[Create Personal Doc Tag - Missing Name] Running negative test: body has no name field");
}

script:post-response {
  const status = res.getStatus();
  const expected = [400, 422];
  if (!expected.includes(status)) {
    console.error(`❌ [Create Personal Doc Tag - Missing Name] Expected ${expected.join(" or ")} — got ${status}`);
    console.error(`Response: ${JSON.stringify(res.getBody())}`);
  } else {
    console.log(`✅ [Create Personal Doc Tag - Missing Name] Correctly rejected with ${status}`);
  }
}

tests {
  test("Status is 400 or 422", function() {
    expect([400, 422]).to.include(res.getStatus());
  });

  test("Response does not indicate success", function() {
    expect(res.getBody().success).to.not.equal(true);
  });
}
